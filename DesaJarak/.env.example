# Database Configuration
# Railway: di service aplikasi, isi DATABASE_URL dengan variable reference
# ${{Postgres.DATABASE_URL}} (ganti Postgres dengan nama service database).
# Lokal: gunakan DATABASE_PUBLIC_URL dari service PostgreSQL Railway,
# atau PostgreSQL lokal (PGHOST=localhost, PGSSL=false).
# Jangan memakai host *.railway.internal dari luar Railway.
DATABASE_URL=postgresql://user:password@host:port/database

# Option 2: Individual variables
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_password
# POSTGRES_DB=e_aspirasi

# SSL override untuk konfigurasi PGHOST/PG*. Otomatis false untuk localhost
# dan *.railway.internal. Untuk DATABASE_URL, gunakan ?sslmode=... di URL.
# PGSSL=true

# Google Gemini AI API Key (optional - for report classification)
# Get from: https://aistudio.google.com/apikey
# Supports both API Key (AIzaSy...) and Bearer Token (AQ.Ab8...)
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth (for Google Sign-In)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here

# Admin password (used for initial seeding)
ADMIN_PASSWORD=admin

# Server port (default: 4173)
PORT=4173

# Resend Email Service (for email verification & notifications)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Application Base URL (required for email verification links)
# Production: https://yourdomain.com
# Development: http://localhost:4173
APP_BASE_URL=http://localhost:4173