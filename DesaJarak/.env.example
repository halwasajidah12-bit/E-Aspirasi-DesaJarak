# Google Cloud OAuth 2.0 Web client ID (public identifier, not a client secret)
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Backend must also have PostgreSQL settings; see the Railway section below.
# Optional: change the seeded admin password before first deployment.
ADMIN_PASSWORD=change-this-before-deployment

# Optional transactional email for status updates and email verification.
# Create a Resend API key and verify the sender domain before using these.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=E-Aspirasi Desa <notifikasi@your-verified-domain.id>
APP_BASE_URL=https://your-public-domain.id

# Web Push for phone notifications (generate with `npx web-push generate-vapid-keys`).
# Keep VAPID_PRIVATE_KEY secret; configure it in the host's environment variables too.
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@your-verified-domain.id
